# ============================================================================
#  GaodeClean —— 【本地临时验证】构建入口（0.9.8 / A15 新增）
#
#  ★ 2026-10-22 起：正式发布包一律由 GitHub Actions 构建（见根 Makefile 与
#    .github/workflows/build-theos.yml）。本文件仅供本机 iSH 快速验证使用，
#    产出物不得作为发布资产。调用方式：make -f Makefile.local <target>
#
#  ██ 警告（2026-11-05 真机事故后新增）██
#  本机 lld 产出的 **arm64e** 切片会直接崩 App，禁止安装！
#    真机日志：AMapiPhone 17.03.0 / iPhone OS 16.2
#      termination.reasons = ["bad bind opcode 0x00"]
#      frames = dyld4::prepare → dyld4::halt → abort_with_payload
#    即 dyld 在**加载阶段**解析 LC_DYLD_INFO_ONLY 的 bind 流时读到非法操作码。
#
#    原因：lld **不支持 arm64e 的 -fixup_chains**（只支持 x86_64 与 arm64），
#    因此 arm64e 只能退回经典 LC_DYLD_INFO_ONLY 绑定；而 lld 写出的这条 bind
#    流在 iOS 16 的 dyld 上不合法。fixarch.py 只修 cpusubtype 与签名页哈希，
#    **不修 bind 流**，所以修不回来。
#
#    判别方法（一条命令）：
#      llvm-objdump --macho --private-headers <dylib> | grep -c LC_DYLD_CHAINED_FIXUPS
#      1 = 合法（theos 产物）    0 = 会崩（lld 的 arm64e 产物）
#
#    ⇒ 本机只允许用来跑 `make check`（语法/单测）与出 **arm64** 切片自测。
#      arm64e 的任何真机安装包，必须走 GitHub Actions（theos）。
#
#  此前仓库没有任何构建脚本：mkdeb.py 里写死 /tmp/gcbuild090 与 VERSION=0.9.0，
#  编译参数只存在于历史对话里，任何人拿到仓库都无法一键重建。
#
#  用法：
#    make            # arm64 + arm64e + 两个 deb（正式包，日志已剥离）
#    make arm64      # 只出 rootless 切片
#    make arm64e     # 只出 RootHide 切片
#    make deb        # 只打包（需先有 dist/*.dylib）
#    make check      # 语法/警告门禁：剥离开 + 剥离关 两遍都必须 0 警告
#    make dev        # 带诊断日志的调试包（不剥离，自己真机排查用）
#    make clean
#
#  SDK 默认 /tmp/sdk165/iPhoneOS16.5.sdk，可用 SDK=... 覆盖。
# ============================================================================

SDK        ?= /tmp/sdk165/iPhoneOS16.5.sdk
CLANG      ?= clang
TARGET_IOS ?= 15.0
OUT        ?= dist
# 0.9.18：打包用的 control（调试包可传 CONTROL=... 带 +diag3 版本，避免产出
#   名字冒充正式包、内容却是调试构建的 deb —— 本轮就踩过这个坑）
CONTROL    ?= control
SRC        := src/GaodeClean.m
HDR        := src/GCCGeometry.h

# 0.9.14（A9）：正式包剥离诊断日志（GCLog → 空操作）。
RELEASE    ?= 1
ifeq ($(RELEASE),1)
STRIPFLAGS := -DGAODECLEAN_STRIP_LOGS=1
else
STRIPFLAGS :=
endif

EXTRA      ?=

COMMON := -isysroot $(SDK) -fobjc-arc -fmodules -O2 \
          -Wall -Wextra -Wno-unused-parameter -I src -fvisibility=hidden -fno-ident \
          $(STRIPFLAGS) $(EXTRA)
LINK   := -dynamiclib \
          -install_name /Library/MobileSubstrate/DynamicLibraries/GaodeClean.dylib \
          -framework UIKit -framework Foundation -fuse-ld=lld -Wl,-adhoc_codesign \
          -Wl,-x -Wl,-dead_strip

DYLIB64  := $(OUT)/GaodeClean-arm64.dylib
DYLIB64E := $(OUT)/GaodeClean-arm64e.dylib

.PHONY: all arm64 arm64e deb check clean

all: deb

arm64: $(DYLIB64)
arm64e: $(DYLIB64E)

# arm64：lld 支持 -fixup_chains，走链式绑定
$(DYLIB64): $(SRC) $(HDR) | $(OUT)
	$(CLANG) -target arm64-apple-ios$(TARGET_IOS) $(COMMON) $(LINK) \
	  -Wl,-fixup_chains -o $@ $(SRC)

# arm64e：lld 不支持 arm64e 的 -fixup_chains，走经典 LC_DYLD_INFO_ONLY；
#         链接后再把 cpusubtype 从 0 改回 2 并重算签名页哈希（见 scripts/fixarch.py）
$(DYLIB64E): $(SRC) $(HDR) | $(OUT)
	$(CLANG) -target arm64e-apple-ios$(TARGET_IOS) $(COMMON) $(LINK) -o $@ $(SRC)
	python3 scripts/fixarch.py $@ 2
	@echo ""
	@echo "╔══════════════════════════════════════════════════════════════╗"
	@echo "║  ⚠️  本机 lld 产出的 arm64e 切片不可安装                     ║"
	@echo "║                                                              ║"
	@echo "║  真机日志：bad bind opcode 0x00（dyld4::prepare 阶段中止）    ║"
	@echo "║  原因：lld 不支持 arm64e 的 -fixup_chains，退回              ║"
	@echo "║        LC_DYLD_INFO_ONLY 且 bind 流不合法                    ║"
	@echo "║                                                              ║"
	@echo "║  仅有 arm64 切片可用于真机自测；arm64e 请走 GitHub Actions。 ║"
	@echo "╚══════════════════════════════════════════════════════════════╝"
	@echo ""

$(OUT):
	mkdir -p $(OUT)

deb: $(DYLIB64) $(DYLIB64E)
	python3 scripts/mkdeb.py --dist $(OUT) --control $(CONTROL) --plist GaodeClean.plist \
	  --dylib-arm64 $(DYLIB64) --dylib-arm64e $(DYLIB64E)

# 门禁：两遍都必须 0 警告 —— ① 正式包（日志剥离）② 调试包（日志保留）：
#   剥离后若某变量只在被剥掉的 GCLog 里用过，会产生 unused-variable 警告，
#   必须在这里就暴露，而不是等真机出问题。
check:
	@for mode in 1 0; do \
	  flag=$$([ $$mode = 1 ] && echo -DGAODECLEAN_STRIP_LOGS=1); \
	  out=$$($(CLANG) -target arm64-apple-ios$(TARGET_IOS) $(COMMON) $$flag -fsyntax-only $(SRC) 2>&1); \
	  if echo "$$out" | grep -q 'warning:'; then \
	    echo "STRIP=$$mode"; echo "$$out"; echo "FAIL: 存在警告"; exit 1; \
	  fi; \
	  echo "OK: 0 warnings (STRIP=$$mode)"; \
	done
	@echo "check: 静态门禁通过"
# 0.9.99（A5）：顶部横幅判定单测 —— 纯 C，无 SDK 依赖，任何机器都能跑。
#   守住「广告角标 + 关闭控件」双证判据：改判据必须同步改测试，否则这里先红。
	@echo "check: 横幅判定单测"
	@gcc -O2 -Wall -Wextra -o /tmp/banner_logic_test tests/banner_logic_test.c -lm \
	  && /tmp/banner_logic_test | tail -3
# 0.9.114（A3）：右上胶囊几何豁免 —— 锁住「+ 号不被按几何找控件的逻辑误抓」。
	@echo "check: 胶囊豁免单测"
	@gcc -O2 -Wall -Wextra -o /tmp/capsule_zone_test tests/capsule_zone_test.c -lm \
	  && /tmp/capsule_zone_test | tail -3
# 0.9.117（A3）：已就位拒绝被隐藏的安全阀 —— 锁住三重阀门与位置校验。
	@echo "check: 安全阀单测"
	@gcc -O2 -Wall -Wextra -o /tmp/pinned_guard_test tests/pinned_guard_test.c -lm \
	  && /tmp/pinned_guard_test | tail -3
# 0.9.120（A1）：右下胶囊几何兜底 —— 锁住「不误认右上 +/图层」。
	@echo "check: 右下几何单测"
	@gcc -O2 -Wall -Wextra -o /tmp/right_geo_test tests/right_geo_test.c -lm \
	  && /tmp/right_geo_test | tail -3
# 0.9.122（A2/A3）：胶囊外壳放行 —— 锁住「外壳也要打 AlignedKey」「中部瞬态位不许放行」。
	@echo "check: 外壳放行单测"
	@gcc -O2 -Wall -Wextra -o /tmp/shell_release_test tests/shell_release_test.c -lm \
	  && /tmp/shell_release_test | tail -3
# 0.9.127（A8）：深色模式底色判定 —— 锁住「深色下不许用浅色底」。
#   起因：切深色后「我的」页下半屏整片白 RGB(254,254,254)，正常深色是 RGB(8,9,13)。
	@echo "check: 深色模式单测"
	@gcc -O2 -Wall -Wextra -o /tmp/dark_mode_test tests/dark_mode_test.c -lm \
	  && /tmp/dark_mode_test | tail -3
# 0.9.20（A2）：混淆回环自测 —— 用与运行时同一份解码数学把 295 条串解回明文，
# 逐条比对 + 校验头内 FNV 摘要；这一步保证「加密后仍 100% 解得原串」。
	@$(CLANG) -O2 -Wall -Wextra -I src -o /tmp/obf_selftest scripts/obf_selftest.c \
	  && /tmp/obf_selftest
	@echo "check: 全部通过"

# 0.9.14：带诊断日志的调试包（不发版，真机排查用）
dev: ; $(MAKE) RELEASE=0 deb

clean:
	rm -f $(DYLIB64) $(DYLIB64E) $(OUT)/*.deb
